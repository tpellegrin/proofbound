[0m$ [0mcd /var/folders/k3/4xs3wtdd6vdfkvf4d272775c0000gn/T/opencode/rgspec && python3 -c "
import math
from fractions import Fraction

def admits(cap, rate, tokens, last, t):
    el = t - last
    if el < 0.0: el = 0.0
    tt = tokens + el*rate
    if tt > cap: tt = float(cap)
    return tt >= 1.0

def smallest(cap, rate, tokens, last, now):
    X = Fraction(last) + (Fraction(1)-Fraction(tokens))/Fraction(rate)
    x = float(X)
    if Fraction(x) < X: x = math.nextafter(x, math.inf)
    if x < now: x = now
    n=0
    while not admits(cap, rate, tokens, last, x):
        x = math.nextafter(x, math.inf); n+=1
        if n>1000: return None, None
    return x, float(X)

# Example 1
x, X = smallest(2, 1.3, 0.0, 1000.0, 1000.0)
print('ex1 X*=',repr(X),'x=',repr(x),'w=',repr(x-1000.0),'excess_ulp=',(Fraction(x)-Fraction(X))/Fraction(math.ulp(x)))
print('  allow at x:', admits(2,1.3,0.0,1000.0,x), ' ulp=',math.ulp(x))
print('  exact real wait:', repr(float(Fraction(1)/Fraction(1.3))))
print('  now+exact wait refuses:', not admits(2,1.3,0.0,1000.0, 1000.0+float(Fraction(1)/Fraction(1.3))))

# Example 2
x, X = smallest(1, 0.09, 0.0, 0.0, 0.0)
print('ex2 X*=',repr(X),'x=',repr(x),'w=',repr(x),'excess_ulp=',(Fraction(x)-Fraction(X))/Fraction(math.ulp(x)))
print('  allow at x:', admits(1,0.09,0.0,0.0,x))
print('  now+exact wait refuses:', not admits(1,0.09,0.0,0.0, float(Fraction(1)/Fraction(0.09))))

# exceptional
print('rate 5e-324 inv:', (1.0-0.0)/5e-324)
"

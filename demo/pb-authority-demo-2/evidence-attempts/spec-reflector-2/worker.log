import math, random
from fractions import Fraction

class Clock:
    def __init__(self, t): self.now=float(t)
    def __call__(self): return self.now

class RG:
    def __init__(self, cap, r, clock):
        self.cap=int(cap); self.r=float(r); self.c=clock; self.tok={}; self.last={}
    def allow(self, key):
        now=self.c()
        tokens=self.tok.get(key, float(self.cap))
        last=self.last.get(key, now)
        el=now-last
        if el<0.0: el=0.0
        tokens=tokens+el*self.r
        if tokens>self.cap: tokens=float(self.cap)
        self.last[key]=now
        if tokens>=1.0:
            self.tok[key]=tokens-1.0; return True
        self.tok[key]=tokens; return False

def admit_state(cap, r, tokens, last, now):
    el=now-last
    if el<0.0: el=0.0
    t=tokens+el*r
    if t>cap: t=float(cap)
    return t>=1.0

def minimal_w(cap, r, tokens, last, now):
    if admit_state(cap,r,tokens,last,now): return 0.0
    target=Fraction(last)+(Fraction(1)-Fraction(tokens))/Fraction(r)
    x=float(target)
    if x<now: x=now
    g=0
    while not admit_state(cap,r,tokens,last,x):
        x=math.nextafter(x, math.inf); g+=1
        if g>100000: return None
    while True:
        p=math.nextafter(x,-math.inf)
        if p>=now and admit_state(cap,r,tokens,last,p): x=p
        else: break
    return x-now

def analyze(cap,r,c0,delta):
    clk=Clock(c0)
    g=RG(cap,r,clk)
    a=g.allow('k'); b=g.allow('k')
    now=c0+delta
    tokens=g.tok['k']; last=g.last['k']
    if admit_state(cap,r,tokens,last,now): return None
    w=minimal_w(cap,r,tokens,last,now)
    if w is None: return ('nofind',)
    x=now+w
    ws=Fraction(last)+(Fraction(1)-Fraction(tokens))/Fraction(r)-Fraction(now)
    excess=Fraction(w)-ws
    ratio=float(excess/Fraction(math.ulp(x)))
    return dict(cap=cap,r=r,c0=c0,delta=delta,now=now,tokens=tokens,last=last,
                w=w,x=x,wstar=float(ws),excess_ulp=ratio,admits=admit_state(cap,r,tokens,last,x))

random.seed(7)
found=[]
for it in range(2000000):
    r=random.choice([0.3,0.5,0.6116579446931443,0.7,0.9,1.3,2.0,0.09,0.11])*10**random.uniform(-1,1)
    c0=-1.0/r + random.uniform(-2.0, 2.0)  # put 1/r near -c0 so x0 near 0
    delta=random.uniform(0, 0.9/r)
    res=analyze(2,r,c0,delta)
    if not res or isinstance(res,tuple): continue
    if res['excess_ulp']>4:
        found.append(res)
        if len(found)>=6: break
print("found over-4 reachable witnesses:", len(found))
for f in found:
    print(f)

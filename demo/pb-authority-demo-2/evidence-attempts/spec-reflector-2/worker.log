import math
from fractions import Fraction

def allow_admits(capacity, refill, tokens, last, now):
    # replicate rateguard.allow token math (without consuming)
    elapsed = now - last
    if elapsed < 0.0:
        elapsed = 0.0
    t = tokens + elapsed * refill
    if t > capacity:
        t = float(capacity)
    return t >= 1.0

def w_star(refill, tokens, last, now):
    # exact real delay to reach token==1 from now, Fraction
    tstar = Fraction(last) + Fraction(1) - Fraction(tokens)
    # (1 - tokens)/refill
    tstar = Fraction(last) + (Fraction(1) - Fraction(tokens)) / Fraction(refill)
    w = tstar - Fraction(now)
    if w < 0:
        w = Fraction(0)
    return w

def minimal_admitting_instant(capacity, refill, tokens, last, now):
    # smallest float x >= now with allow_admits at x
    if allow_admits(capacity, refill, tokens, last, now):
        return now
    # if tokens already >=1 admits; else search upward. Use nextafter stepping
    # estimate target
    x = now
    # coarse jump using exact target then walk
    target = Fraction(last) + (Fraction(1) - Fraction(tokens)) / Fraction(refill)
    if target > x:
        x = float(target)
        # ensure >= now
        if x < now:
            x = now
        # step back while previous still admits
        while True:
            p = math.nextafter(x, -math.inf)
            if p >= now and allow_admits(capacity, refill, tokens, last, p):
                x = p
            else:
                break
        # step forward if not admitting
        while not allow_admits(capacity, refill, tokens, last, x):
            x = math.nextafter(x, math.inf)
    else:
        while not allow_admits(capacity, refill, tokens, last, x):
            x = math.nextafter(x, math.inf)
    return x

def check(capacity, refill, tokens, last, now):
    if allow_admits(capacity, refill, tokens, last, now):
        return None
    x0 = minimal_admitting_instant(capacity, refill, tokens, last, now)
    if x0 == math.inf:
        return ('inf', None)
    wmin = x0 - now
    ws = w_star(refill, tokens, last, now)
    excess = Fraction(wmin) - ws
    ulp = math.ulp(x0)
    ratio = float(excess / Fraction(ulp)) if ulp > 0 else float('inf')
    return (x0, wmin, float(ws), ratio)

# 1) verify intent's two counterexamples
print("intent ex1:", check(2, 1.3, 0.0, 1000.0, 1000.0))  # capacity 2, drained by 2 admissions => tokens 0, last 1000
# actually two admissions: start full 2, after two allow tokens=0, last=1000. now=1000
print("intent ex2:", check(1, 0.09, 0.0, 0.0, 0.0))

# 2) random search for ratio > 4
import random
random.seed(12345)
worst = (0, None)
over = []
refills = [1e-3,1e-2,0.05,0.09,0.1,0.3,0.5,0.7,1.0,1.3,2.0,3.0,7.0,1e-6,1e-9,1e-12]
clocks = [0.0,1.0,1000.0,1e6,1e12,-1000.0,-1e6]
caps = [1,2,3,10,1000]
for it in range(300000):
    cap = random.choice(caps)
    r = random.choice(refills) * (10 ** random.uniform(-3,3))
    last = random.choice(clocks) * (10 ** random.uniform(-3,3))
    now = last + random.uniform(0, 2.0/r)
    tokens = random.uniform(0, min(1.0, cap))
    res = check(cap, r, tokens, last, now)
    if res is None: continue
    if res[0] == 'inf': continue
    ratio = res[3]
    if ratio > worst[0]:
        worst = (ratio, (cap, r, tokens, last, now, res))
    if ratio > 4:
        over.append((cap, r, tokens, last, now, res))
        if len(over) >= 10: break
print("worst ratio:", worst[0])
print("worst case:", worst[1])
print("num over 4 (capped 10):", len(over))
for o in over[:5]:
    print("OVER:", o)

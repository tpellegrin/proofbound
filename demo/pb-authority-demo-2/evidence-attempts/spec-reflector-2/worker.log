import math, random
from fractions import Fraction

def admit(cap, refill, tokens, last, now):
    el = now - last
    if el < 0.0: el = 0.0
    t = tokens + el * refill
    if t > cap: t = float(cap)
    return t >= 1.0

def wstar(refill, tokens, last, now):
    return Fraction(last) + (Fraction(1)-Fraction(tokens))/Fraction(refill) - Fraction(now)

def ulps(x):
    return math.ulp(x)

def best_excess(cap, refill, tokens, last, now):
    """find min over admitting w of (w - w*)/ulp(now+w); None if none finite admit."""
    if admit(cap, refill, tokens, last, now):
        return ('admitted', None)
    # find a starting x above threshold using exact target
    target = Fraction(last) + (Fraction(1)-Fraction(tokens))/Fraction(refill)
    x = float(target)
    if x < now: x = now
    # walk to first admitting
    guard=0
    while not admit(cap,refill,tokens,last,x):
        x = math.nextafter(x, math.inf); guard+=1
        if guard>10000: return ('nofind', None)
    while True:
        p = math.nextafter(x, -math.inf)
        if p>=now and admit(cap,refill,tokens,last,p):
            x=p
        else: break
    # now x is minimal admitting instant (approx)
    # candidate w: any float w such that now+w admits. smallest w is around x-now
    ws = wstar(refill,tokens,last,now)
    # gather candidate w values: x-now and a few nextafter around it, plus nextafter(x) derived
    cands=set()
    w0 = x - now
    w = w0
    for _ in range(5):
        cands.add(w)
        w = math.nextafter(w, math.inf)
    w = w0
    for _ in range(5):
        cands.add(w)
        w = math.nextafter(w, -math.inf)
    best=None
    for w in cands:
        if w < 0: continue
        xx = now + w
        if not admit(cap,refill,tokens,last,xx): continue
        excess = Fraction(w) - ws
        ratio = float(excess / Fraction(ulps(xx))) if ulps(xx)>0 else float('inf')
        if best is None or ratio < best[0]:
            best=(ratio, w, xx, excess, float(ws))
    return best

# focused search: NON-NEGATIVE clocks only
random.seed(999)

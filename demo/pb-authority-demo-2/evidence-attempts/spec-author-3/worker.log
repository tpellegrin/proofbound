import math
from fractions import Fraction as F

CAP=2; REFILL=0.5189678343212376; LAST=-1.9412437153089475; TOKENS=0.0
NOW=-1.019128334982796

def admitted(x):
    elapsed = x - LAST
    if elapsed < 0.0: elapsed = 0.0
    t = TOKENS + elapsed*REFILL
    if t > CAP: t = CAP
    return t >= 1.0

tstar = F(LAST) + (F(1)-F(TOKENS))/F(REFILL)

def exists_ok(now):
    wstar_real = tstar - F(now)
    if wstar_real <= 0: return True, None
    # find minimal admitting w via stepping from wstar float
    w = float(wstar_real)
    # ensure admitted, step up
    for _ in range(10000):
        if admitted(now + w): break
        w = math.nextafter(w, math.inf)
    else:
        return False, None
    for _ in range(10000):
        c = math.nextafter(w, -math.inf)
        if now + c == now + w:  # no change in reached instant
            w = c; continue
        if admitted(now + c): w = c
        else: break
    x = now + w
    return (F(w) - wstar_real) <= 4*F(math.ulp(x)), w

ok, w = exists_ok(NOW)
print("witness NOW ok?", ok, "w=", repr(w), "excess ratio", float((F(w)-tstar+F(NOW))/math.ulp(NOW+w)))

# scan larger w above w_min for the witness state
wmin = w
found=None
for i in range(1,200000):
    ww = wmin
    for _ in range(i): ww = math.nextafter(ww, math.inf)  # O(n^2) too slow; do differently
    break
# faster scan
ww = wmin
for i in range(200000):
    x = NOW + ww
    if F(ww) - (tstar - F(NOW)) <= 4*F(math.ulp(x)):
        found=(i, ww, x); break
    ww = math.nextafter(ww, math.inf)
print("any larger w satisfies within 200000 steps?", found)

# Monotonicity of fixed answer as now advances (intent 4): finite vs inf
print()
print("=== as now advances ===")
prev=None
transitions=[]
nows=[NOW - 0.5, NOW - 0.1, NOW - 1e-3, NOW, NOW + 1e-3, NOW + 1e-2, NOW + 0.1]
for n in nows:
    ok,w2 = exists_ok(n)
    ans = "inf" if not ok else ("0.0" if n >= float(tstar) else repr(w2))
    print("now", repr(n), "->", ans, "(ok)" if ok else "(INF)")

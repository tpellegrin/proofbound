import math, sys
sys.path.insert(0, "/Users/thiago/.proofbound/demo2/live/project")
from rateguard import RateGuard

CAP = 2
REFILL = 0.5189678343212376
LAST = -1.9412437153089475
TOKENS = 0.0

def admitted_at(x, cap=CAP, refill=REFILL, tokens=TOKENS, last=LAST):
    elapsed = x - last
    if elapsed < 0.0: elapsed = 0.0
    t = tokens + elapsed * refill
    if t > cap: t = float(cap)
    return t >= 1.0

def exact_wstar(now, cap=CAP, refill=REFILL, tokens=TOKENS, last=LAST):
    return max(0.0, (last + (1 - tokens)/refill) - now)

def minimal_admitting_w(now, cap=CAP, refill=REFILL, tokens=TOKENS, last=LAST):
    # exact target
    tstar = last + (1 - tokens)/refill
    wstar = max(0.0, tstar - now)
    # start from wstar and step up in delay until admitted; also step down to ensure minimal
    w = wstar
    # step up
    for _ in range(100000):
        x = now + w
        if admitted_at(x, cap, refill, tokens, last):
            break
        w = math.nextafter(w, math.inf)
    else:
        return None
    # step down to minimal
    for _ in range(100000):
        cand = math.nextafter(w, -math.inf)
        if cand < 0: break
        x = now + cand
        if admitted_at(x, cap, refill, tokens, last):
            w = cand
        else:
            break
    return w

now = -1.019128334982796
wstar = exact_wstar(now)
w = minimal_admitting_w(now)
x = now + w
excess = w - wstar
ulp_x = math.ulp(x)
print("wstar", repr(wstar))
print("minimal w", repr(w))
print("x", repr(x))
print("admitted_at(x)", admitted_at(x))
print("excess", excess)
print("ulp(x)", ulp_x)
print("excess/ulp", excess/ulp_x)
print("within 4 ulp (a)+(b) satisfiable:", excess <= 4*ulp_x)

# Check: does any finite w satisfy both (a) and (b)?
# best case is minimal admitting w (minimizes x, hence excess); but ulp bound evaluated at its x
print()
print("=== intent counterexamples ===")

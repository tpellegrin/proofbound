    w_exact=wstar
    print(" x(wstar)=", repr(now+w_exact), "admitted", admitted_at(now+w_exact,2,1.3,tokens,last))
    w_next=math.nextafter(wstar,math.inf)
    print(" x(next)=", repr(now+w_next), "admitted", admitted_at(now+w_next,2,1.3,tokens,last))
    wmin=minimal_admitting_w(now,2,1.3,tokens,last)
    print(" minimal admitting w", repr(wmin), "x", repr(now+wmin), "admitted", admitted_at(now+wmin,2,1.3,tokens,last))
cx1()

